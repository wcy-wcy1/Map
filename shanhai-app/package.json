{
  "name": "shanhai-app",
  "version": "0.2.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "package:trial": "node scripts/package.mjs",
    "qa:cutover": "node scripts/qa-cutover.mjs",
    "sync:reference-assets": "node scripts/sync-reference-assets.mjs",
    "sync:kernels": "node scripts/sync-legacy-kernels.mjs"
  },
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "dependencies": { "leaflet": "1.9.4", "vue": "3.5.42" },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
